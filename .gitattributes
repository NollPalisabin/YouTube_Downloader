# 统一换行符：仓库内一律 LF，避免 Windows 上 autocrlf 让
# build_macos.sh 变成 CRLF 而在 macOS 上执行失败（"$\r: command not found"）
* text=auto

*.sh    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ico   binary
*.png   binary
